{
  "name": "mklabs-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "MKLabs — software development and technology solutions, Bulawayo, Zimbabwe",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-server && node scripts/prerender.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build && node scripts/check-build.js"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
